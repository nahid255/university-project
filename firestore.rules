rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user role as admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check document ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if current user manages a club
    function isClubManager(clubId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.managerIds;
    }

    // =========================================================
    // V1 COLLECTIONS (PRESERVED & HARDENED)
    // =========================================================

    // Users Collection
    match /users/{userId} {
      // Authenticated campus members can read profiles for directory & public profiles
      allow read: if isAuthenticated();
      // Users can create their own profile upon registration with default role 'student'
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      // Users can update their own permitted profile fields (cannot change role)
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // Academic Class Routines
    match /routines/{routineId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Academic Examinations
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Student Assignments (Private per student)
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // University Notices
    match /notices/{noticeId} {
      // Students can read published notices; admins can read all
      allow read: if isAuthenticated() && (resource.data.status == 'published' || isAdmin());
      allow write: if isAdmin();
    }

    // Lost & Found Items
    match /lostFoundItems/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
    }

    // Claim Requests on Found Items
    match /claimRequests/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.claimantId == request.auth.uid ||
        resource.data.itemReporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.itemReporterId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.claimantId == request.auth.uid ||
        isAdmin()
      );
    }

    // Study Resources
    match /studyResources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedById == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uploadedById == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uploadedById == request.auth.uid || isAdmin());
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // V2 COLLECTIONS
    // =========================================================

    // Community Posts
    match /posts/{postId} {
      allow read: if isAuthenticated() && (
        resource.data.status == 'active' ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'active';
      // Author/admin can edit post; peers may only adjust engagement counters
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Community Comments & Replies
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Community Post Likes (deterministic ID: {postId}_{userId})
    match /postLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        likeId == (request.resource.data.postId + '_' + request.auth.uid);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Student Marketplace Listings
    match /marketplaceListings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Book Exchange Listings
    match /bookListings/{bookId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Campus Events (Admins manage events; students can update registration counts on enroll/cancel)
    match /events/{eventId} {
      allow read: if isAuthenticated() && (resource.data.status == 'published' || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'waitlistCount', 'updatedAt'])
      );
    }

    // Event Registrations
    match /eventRegistrations/{registrationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        registrationId == (request.resource.data.eventId + '_' + request.auth.uid);
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Official University Clubs (Creation & deletion strictly restricted to Admins)
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.isVerifiedOfficial == true;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid in resource.data.managerIds &&
        request.resource.data.isVerifiedOfficial == resource.data.isVerifiedOfficial &&
        request.resource.data.managerIds == resource.data.managerIds
      );
      allow delete: if isAdmin();
    }

    // Club Memberships
    match /clubMemberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isClubManager(resource.data.clubId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'member' &&
        membershipId == (request.resource.data.clubId + '_' + request.auth.uid);
      allow update: if isAdmin() || isClubManager(resource.data.clubId);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Authenticated users can emit notifications triggered by interactions (comments, likes, inquiries)
      allow create: if isAuthenticated() &&
        request.resource.data.isRead == false;
    }

    // Private 1-to-1 Conversations (STRICT participant-only access; NO admin override)
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow delete: if false;
    }

    // Private 1-to-1 Messages (STRICT participant-only access; NO admin override; immutable)
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update, delete: if false;
    }

    // Blocked Users (Owner manages block list; targeted user can get single deterministic doc for delivery check)
    match /blockedUsers/{blockId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow list: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.blockerId == request.auth.uid &&
        blockId == (request.auth.uid + '_' + request.resource.data.blockedId);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // Content Moderation Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}
